given
    $db_id: integer,
    $display_name: string?,
    $schema_class: string?,
    $st_id: string?,
    $old_st_id: string?,
    $variant_identifier: string?,
    $sequence_length: integer?,
    $identifier: string?;
insert
$x isa reference-isoform, has db-id == $db_id;
try { $x has display-name == $display_name; };
try { $x has schema-class == $schema_class; };
try { $x has st-id == $st_id; };
try { $x has old-st-id == $old_st_id; };
try { $x has variant-identifier == $variant_identifier; };
try { $x has sequence-length == $sequence_length; };
try { $x has identifier == $identifier; };
